KEYMINT_ADMIN_API_KEY=km_live_your_admin_api_key_here
KEYMINT_CLIENT_API_KEY=km_live_your_client_api_key_here
KEYMINT_PRODUCT_ID=prod_your_product_id_here
# Webhook signing secret from the dashboard: 64 hex characters, no prefix.
# The webhook route refuses requests (503) until it is set.
KEYMINT_WEBHOOK_SECRET=
# Protects POST /api/licenses. Generate one with: openssl rand -hex 32
LICENSE_API_SECRET=
